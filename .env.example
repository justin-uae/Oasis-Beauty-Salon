# Copy to ".env.local" for local dev, or set in your build environment before
# running "npm run build" (this value is baked into the static output at build time).

# reCAPTCHA v2 SITE key (public) from https://www.google.com/recaptcha/admin
# Pair with the matching RECAPTCHA_SECRET_KEY set on the server for submit.php (see public/.env.example).
# Leave unset to use Google's published test site key (always passes — fine for testing, not for launch).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics measurement ID, used by app/components/Tracking.tsx
NEXT_PUBLIC_GA_ID=
