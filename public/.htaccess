RewriteEngine On

# Force HTTPS and WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,NE,R=301]

# Never expose raw directory listings. Next.js's static export creates a
# real directory for any route that also has nested dynamic children (e.g.
# /countries/ holds every /countries/[country] page), which shadows that
# route's own "<name>.html" file — without this Apache would dump a raw
# file index instead of serving the page.
Options -Indexes

# When the request resolves to a real directory with no index.html of its
# own, serve the sibling "<name>.html" file one level up instead (this is
# what makes /countries, /services and /countries/united-kingdom resolve
# to their actual page instead of a directory listing).
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_URI} ^/(.*[^/])/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1.html [L]

# Clean URLs: /about -> about.html, when nothing already matches a real
# file or directory on disk.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.*[^/])/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1.html [L]

# Anything else that isn't a real file or directory: show the 404 page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /404.html [L]

# Block direct access to PHP error logs written alongside send-quote.php.
<FilesMatch "\.log$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
