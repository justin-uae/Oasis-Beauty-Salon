# Copy this file to ".env" in the SAME folder as submit.php on the live server
# (i.e. next to submit.php in your web root). Do not commit the real .env file.

# reCAPTCHA v2 secret key from https://www.google.com/recaptcha/admin
# Leave unset to use Google's test key (always passes — fine for testing, not for launch).
RECAPTCHA_SECRET_KEY=

# Mailbox that receives enquiries.
NOTIFY_EMAIL=bookings@oasisaltrincham.co.uk

# Must be a real mailbox/alias on this hosting account, or your mail server may reject it.
FROM_EMAIL=noreply@oasisaltrincham.co.uk
